# Copie este arquivo para `.env` na raiz do projeto (o .env é ignorado pelo Git) ou
# configure estes nomes no provedor de deploy. O app lê o .env ao iniciar
# (OSDroupa/env.py); variáveis já definidas no terminal têm prioridade sobre o arquivo.
# Nunca coloque credenciais reais neste arquivo nem no controle de versão.
# xano = backend da apresentação; sqlite = desenvolvimento local. Sem esta variável, o código usa sqlite.
OSDROUPA_BACKEND=xano
OSDROUPA_DB_PATH=
OSDROUPA_PUBLIC_URL=

# Checkout Mercado Pago Orders. Sem ambos os segredos, a venda real fica indisponível.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Recuperação por e-mail (opcional no modo local).
OSDROUPA_SMTP_HOST=
OSDROUPA_SMTP_PORT=587
OSDROUPA_SMTP_FROM=
OSDROUPA_SMTP_USER=
OSDROUPA_SMTP_PASSWORD=

# Estilista com IA — Google Gemini (Change 029). Sem a chave, o Look do Dia usa a sugestão básica por regras.
# A chave é lida apenas no servidor Reflex; nunca a exponha no frontend.
# Plano gratuito: o Google informa que o conteúdo enviado pode ser usado para melhorar os produtos dele.
OSDROUPA_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Limites persistentes (SQLite local; valem após reiniciar). Ajuste conforme a cota mostrada em
# aistudio.google.com/rate-limit — a cota diária do Google zera à meia-noite no horário do Pacífico.
OSDROUPA_AI_LOOKS_PER_HOUR=10
OSDROUPA_AI_RPM=5
OSDROUPA_AI_DAILY_LIMIT=200
OSDROUPA_AI_QUOTA_PAUSE_SECONDS=60

# Imagem do look (Change 027). PAGA — não há plano gratuito para geração de imagens.
# Fica desligada por padrão; só ative depois de conferir o preço e o faturamento do projeto.
OSDROUPA_IMAGES_ENABLED=false
OSDROUPA_IMAGE_MODEL=gemini-nano-banana-2.1
OSDROUPA_IMAGES_PER_HOUR=5
OSDROUPA_IMAGES_RPM=2
OSDROUPA_IMAGES_DAILY_LIMIT=20
