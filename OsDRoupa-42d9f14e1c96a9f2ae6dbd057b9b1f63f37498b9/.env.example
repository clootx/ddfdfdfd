# Copie para o ambiente local ou configure estes nomes no provedor de deploy.
# Nunca coloque credenciais reais neste arquivo nem no controle de versão.
OSDROUPA_BACKEND=xano
OSDROUPA_DB_PATH=
OSDROUPA_PUBLIC_URL=

# Checkout Mercado Pago Orders. Sem ambos os segredos, a venda real fica indisponível.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Recuperação por e-mail (opcional no modo local).
OSDROUPA_SMTP_HOST=
OSDROUPA_SMTP_PORT=587
OSDROUPA_SMTP_FROM=
OSDROUPA_SMTP_USER=
OSDROUPA_SMTP_PASSWORD=
